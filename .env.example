# Имя проекта Docker Compose
COMPOSE_PROJECT_NAME=flibusta

# Порт веб-интерфейса и OPDS на хосте (http://localhost:27100)
WEB_PORT=27100

# Внешний порт PostgreSQL (при необходимости прямого подключения)
PG_PORT=27101

# Параметры подключения к PostgreSQL
POSTGRES_USER=flibusta
POSTGRES_PASSWORD=flibusta
POSTGRES_DB=flibusta

# Пароль для доступа к разделу "Сервис" (/service/ - обновление базы, очистка кэша).
# Оставьте пустым, если авторизация в локальной сети не требуется.
SERVICE_PASSWORD=

# Пути к директориям на хосте
BOOKS_DIR=./Flibusta.Net
SQL_DIR=./FlibustaSQL
CACHE_DIR=./cache

# Зеркала для скачивания (при блокировках можно указать рабочее зеркало или Tor proxy)
FLIBUSTA_SQL_URL=https://flibusta.is/sql/
FLIBUSTA_DAILY_URL=https://flibusta.is/daily/
